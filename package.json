    "db:check": "drizzle-kit check",
    "content:schema": "tsx scripts/content-schema.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",

    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:import": "tsx scripts/content-import.ts",
    "content:new": "tsx scripts/content-new.ts",
    "content:ingest": "tsx scripts/content-ingest.ts",
    "xlsx:convert": "python3 scripts/xlsx-to-content.py",

# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit .env.local.
# Supabase Dashboard > Project Settings > API
# ─────────────────────────────────────────────────────────────────────────────

# Public: safe to expose in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute origin used for magic-link redirects.
# Local: http://localhost:3000 — on Vercel this is detected automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Server only. Never prefix with NEXT_PUBLIC_, never commit.
# Used by `pnpm content:import` to write course content, which Row Level
# Security blocks for every ordinary user.
# Supabase Dashboard > Project Settings > Database > Connection string > URI
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
